<Window x:Class="Studio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                Title="STUDIO V01 — ETAPA 3"
        Width="1500" Height="900" MinWidth="1200" MinHeight="700"
        Background="#080808" WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_KeyDown" Focusable="True">
    <Window.Resources>
        <Style x:Key="SourceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SourceNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,7"/>
        </Style>
        <Style x:Key="OverlayToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="55"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#080808" Foreground="White" BorderBrush="#303030" Padding="4">
        <TabItem Header="PROGRAMA" Background="#161616" Foreground="White">
        <Grid Background="#080808" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121212" CornerRadius="8" Padding="10" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="410"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FUENTES" Foreground="White" FontSize="18" FontWeight="Bold" Margin="4,2,4,10"/>

                        <Border x:Name="CardPuente" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="PUENTE" Style="{StaticResource SourceNameStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="🌤" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="0|climate"/>
                                    <ToggleButton Content="🐓" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="0|logo"/>
                                    <ToggleButton Content="📰" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="0|news"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardPuerto" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="PUERTO" Style="{StaticResource SourceNameStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="🌤" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="1|climate"/>
                                    <ToggleButton Content="🐓" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="1|logo"/>
                                    <ToggleButton Content="📰" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="1|news"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardEsquina" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="ESQUINA" Style="{StaticResource SourceNameStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="🌤" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="2|climate"/>
                                    <ToggleButton Content="🐓" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="2|logo"/>
                                    <ToggleButton Content="📰" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="2|news"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardEdificio" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="EDIFICIO JJ" Style="{StaticResource SourceNameStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="🌤" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="3|climate"/>
                                    <ToggleButton Content="🐓" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="3|logo"/>
                                    <ToggleButton Content="📰" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="3|news"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardQuad" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="4 CÁMARAS" Style="{StaticResource SourceNameStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="🌤" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="4|climate"/>
                                    <ToggleButton Content="🐓" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="4|logo"/>
                                    <ToggleButton Content="📰" Style="{StaticResource OverlayToggleStyle}" Click="OverlayToggle_Click" Tag="4|news"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardGrilla" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="GRILLA" Style="{StaticResource SourceNameStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardProgramas" Style="{StaticResource SourceCardStyle}" MouseLeftButtonUp="SourceCard_Click">
                            <StackPanel>
                                <TextBlock Text="PLACA DE PROGRAMAS" Style="{StaticResource SourceNameStyle}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AirStatusText" Text="AL AIRE: —" Foreground="#AAAAAA" FontSize="13" Margin="5,10,5,4"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Background="#0B0B0B" CornerRadius="7" Padding="8" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="115"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="🎵 M3U8" Foreground="White" FontSize="16" FontWeight="Bold" Margin="3,0,0,7"/>
                            <Grid x:Name="AudioHost" Height="95"/>
                        </StackPanel>

                        <Border Grid.Row="1" Background="#262626"/>

                        

                        
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#000000" CornerRadius="8" BorderBrush="#262626" BorderThickness="1">
            <Grid x:Name="PreviewContainer" ClipToBounds="True" SizeChanged="PreviewContainer_SizeChanged">
                <Grid x:Name="ProgramCanvas"
                      Width="1920"
                      Height="1080"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Background="#000000"
                      ClipToBounds="True">
                    <Image x:Name="PreviewImage" Stretch="Fill" Visibility="Collapsed"/>
                    <Grid x:Name="QuadPreview" Visibility="Collapsed" Background="#080808">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image x:Name="QuadImage0" Grid.Row="0" Grid.Column="0" Stretch="Fill"/>
                        <Image x:Name="QuadImage1" Grid.Row="0" Grid.Column="1" Stretch="Fill"/>
                        <Image x:Name="QuadImage2" Grid.Row="1" Grid.Column="0" Stretch="Fill"/>
                        <Image x:Name="QuadImage3" Grid.Row="1" Grid.Column="1" Stretch="Fill"/>
                    </Grid>
                    <Grid x:Name="HtmlHost" Visibility="Collapsed"/>
                    <Grid x:Name="ClimateHost" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="10"/>
                    <Grid x:Name="LogoHost" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="20"/>
                    <Grid x:Name="NewsHost" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="15"/>
                </Grid>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14"
                        Padding="10,6" CornerRadius="5" Background="#CC111111" Panel.ZIndex="100">
                    <TextBlock x:Name="StatusText" Foreground="White" FontSize="14" Text="INICIANDO..."/>
                </Border>
            </Grid>
        </Border>
    </Grid>
        </TabItem>
        <TabItem Header="OVERLAYS" Background="#161616" Foreground="White">
            <ScrollViewer Background="#101010" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="1050" HorizontalAlignment="Left">
                <TextBlock Text="OVERLAYS Y ENTRADA NDI" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Administrá aquí las capas gráficas y elegí la fuente NDI entrante. Conectar al aire cambia el programa a NDI; VOLVER AL PROGRAMA retoma el ciclo automático." Foreground="#BBBBBB" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ENTRADA NDI · SELECCIÓN Y CONTROL AL AIRE" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="NdiSourceCombo" Grid.Column="0" Height="34" Margin="0,0,8,0" ToolTip="Seleccioná una fuente NDI" SelectionChanged="NdiSourceCombo_SelectionChanged"/>
                            <Button Grid.Column="1" Content="REFRESCAR" Height="34" Click="NdiRefresh_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="NdiConnectButton" Content="PASAR NDI AL AIRE" Height="36" Margin="0,0,4,0" Click="NdiConnect_Click"/>
                            <Button Grid.Column="1" x:Name="NdiReturnButton" Content="VOLVER AL PROGRAMA" Height="36" Margin="4,0,0,0" Click="NdiReturn_Click"/>
                        </Grid>
                        <TextBlock x:Name="NdiRuntimeStatus" Text="NDI: buscando Runtime..." Foreground="#AAAAAA" FontSize="12" Margin="2,0,2,2"/>
                    </StackPanel>
                </Border>
                <Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CAPAS GRÁFICAS" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Clima, mosca/logo y noticias se mantienen como overlays del programa. Los controles de activación por fuente están en la pestaña PROGRAMA." Foreground="#BBBBBB" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="STINGERS" Background="#161616" Foreground="White">
            <ScrollViewer Background="#101010" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="1000" HorizontalAlignment="Left">
<TextBlock Text="STINGERS · TRANSICIONES" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
<TextBlock Text="Cargá un ZIP o RAR con la secuencia de imágenes. Se copiará y extraerá en la carpeta Stingers." Foreground="#BBBBBB" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,18"/>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="STINGER 0 · ENTRADA A NDI" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
<DockPanel><Button Content="SELECCIONAR ZIP / RAR" Width="190" Height="36" Click="Stinger0Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Stinger0PathBox" Height="36" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
<TextBlock x:Name="Stinger0StatusText" Text="Sin secuencia cargada" Foreground="#AAAAAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
<TextBlock Text="STINGER 5 · REGRESO AL PROGRAMA" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
<DockPanel><Button Content="SELECCIONAR ZIP / RAR" Width="190" Height="36" Click="Stinger5Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Stinger5PathBox" Height="36" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
<TextBlock x:Name="Stinger5StatusText" Text="Sin secuencia cargada" Foreground="#AAAAAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="SALIDAS" Background="#161616" Foreground="White">
            <ScrollViewer Background="#101010" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="1050" HorizontalAlignment="Left">
<TextBlock Text="SALIDAS INDEPENDIENTES" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
<TextBlock Text="Configurá cada salida por separado. SRT trabaja como Caller hacia un receptor Listener; YouTube usa RTMP/RTMPS y su clave propia." Foreground="#BBBBBB" FontSize="14" Margin="0,0,0,18"/>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="NDI · SALIDA DE RED" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
<DockPanel><Button Content="APLICAR NOMBRE" Width="150" Height="36" Click="ApplyNdiOutput_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="NdiOutputNameBox2" Height="36" Padding="8" Text="STUDIO V01" Background="#101010" Foreground="White" BorderBrush="#444444" VerticalContentAlignment="Center"/></DockPanel>
<TextBox x:Name="NdiOutputNameBox" Height="1" Visibility="Collapsed" TextChanged="NdiOutputNameBox_TextChanged"/>
<TextBlock x:Name="NdiOutputStatus" Text="NDI SALIDA: iniciando..." Foreground="#7FC7FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
<TextBlock Text="Esta salida publica el programa final con el nombre indicado. La selección de la fuente NDI entrante está en OVERLAYS." Foreground="#AAAAAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="SRT CALLER" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Text="IP LOCAL DE ESTA PC (detección automática)" Foreground="#BBBBBB" Margin="0,0,0,5"/><ComboBox x:Name="SrtLocalIpCombo" Height="34" Margin="0,0,0,10" Background="#101010" Foreground="White"/>
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="IP / host DE LA OTRA PC (SRT Listener)" Foreground="#BBBBBB" Margin="0,0,0,5"/><TextBox x:Name="SrtHostBox" Height="34" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" VerticalContentAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Puerto remoto" Foreground="#BBBBBB" Margin="0,0,0,5"/><TextBox x:Name="SrtPortBox" Height="34" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" VerticalContentAlignment="Center" Text="9000"/></StackPanel></Grid>
<TextBlock Text="Esta PC transmite como CALLER. En la otra PC, configurá SRT Listener en el mismo puerto. No pongas aquí la IP local de esta PC, salvo que el receptor esté en la misma máquina." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,10"/>
<DockPanel><Button x:Name="SrtStartButton2" Content="INICIAR SRT CALLER" Width="190" Height="38" Click="SrtStart_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="SrtStopButton2" Content="DETENER SRT" Width="120" Height="38" Click="SrtStop_Click" IsEnabled="False" DockPanel.Dock="Right" Margin="0,0,8,0"/><TextBlock x:Name="SrtStatusText" Text="SRT: detenido" Foreground="#AAAAAA" VerticalAlignment="Center"/></DockPanel>
</StackPanel></Border>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
<TextBlock Text="YOUTUBE · RTMP / RTMPS" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Text="URL del servidor" Foreground="#BBBBBB" Margin="0,0,0,5"/><TextBox x:Name="YoutubeServerBox" Height="34" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" Text="rtmps://a.rtmps.youtube.com/live2" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
<TextBlock Text="Clave de transmisión" Foreground="#BBBBBB" Margin="0,0,0,5"/><PasswordBox x:Name="YoutubeKeyBox" Height="34" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" Margin="0,0,0,10"/>
<DockPanel><Button x:Name="RtmpStartButton2" Content="INICIAR YOUTUBE" Width="170" Height="38" Click="RtmpStart_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="RtmpStopButton2" Content="DETENER" Width="110" Height="38" Click="RtmpStop_Click" IsEnabled="False" DockPanel.Dock="Right" Margin="0,0,8,0"/><TextBlock x:Name="YoutubeStatusText" Text="YouTube RTMP: detenido" Foreground="#AAAAAA" VerticalAlignment="Center"/></DockPanel>
<TextBlock Text="La clave se muestra oculta. No la publiques ni la compartas." Foreground="#AAAAAA" FontSize="12" Margin="0,8,0,0"/>
</StackPanel></Border>
<TextBlock Text="Aviso técnico: esta interfaz configura las salidas. Para emitir la composición final completa (cámaras, HTML, overlays y audio), aún falta integrar el mezclador de programa en el flujo de salida." Foreground="#E8C66A" TextWrapping="Wrap" Margin="0,14,0,0"/>
</StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="SONIDO / PLAYLIST" Background="#161616" Foreground="White">
            <ScrollViewer Background="#101010" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="1000" HorizontalAlignment="Left">
<TextBlock Text="SONIDO / PLAYLIST M3U8" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
<TextBlock Text="Elegí el archivo de playlist desde el equipo. La ruta se guarda en la configuración local." Foreground="#BBBBBB" FontSize="14" Margin="0,0,0,18"/>
<Border Background="#191919" BorderBrush="#383838" BorderThickness="1" CornerRadius="8" Padding="16"><StackPanel>
<TextBlock Text="ARCHIVO DE PLAYLIST" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
<DockPanel><Button Content="BUSCAR ARCHIVO M3U8" Width="190" Height="38" Click="M3u8Browse_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="M3u8PathBox" Height="38" Padding="8" Background="#101010" Foreground="White" BorderBrush="#444444" IsReadOnly="True" VerticalContentAlignment="Center"/></DockPanel>
<TextBlock x:Name="M3u8StatusText" Text="No se seleccionó archivo local." Foreground="#AAAAAA" Margin="0,10,0,0" TextWrapping="Wrap"/>
<TextBlock Text="Nota: las playlists M3U8 locales con segmentos relativos necesitan servirse por HTTP para que el reproductor web acceda a los archivos de video." Foreground="#AAAAAA" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
</StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="CÁMARAS" Background="#161616" Foreground="White">
            <Grid Background="#101010" Margin="12"><StackPanel>
                <TextBlock Text="CÁMARAS" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Las fuentes de cámara y la grilla se seleccionan desde PROGRAMA. La recepción NDI se administra en OVERLAYS y la publicación NDI en SALIDAS." Foreground="#BBBBBB" FontSize="14" TextWrapping="Wrap"/>
                <!-- Compatibilidad interna con el controlador de salidas existente; la interfaz visible está en SALIDAS. -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="StreamOutputStatus" Text="SALIDAS: detenidas"/>
                    <Button x:Name="SrtStartButton" IsEnabled="True"/>
                    <Button x:Name="SrtStopButton" IsEnabled="False"/>
                    <Button x:Name="RtmpStartButton" IsEnabled="True"/>
                    <Button x:Name="RtmpStopButton" IsEnabled="False"/>
                </StackPanel>
            </StackPanel></Grid>
        </TabItem>
        <TabItem Header="CONFIGURACIÓN" Background="#161616" Foreground="White">
            <Grid Background="#101010" Margin="12"><StackPanel>
                <TextBlock Text="CONFIGURACIÓN GENERAL" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="La configuración editable deberá guardar cámaras, URLs RTSP, fuentes HTML, duración del ciclo, overlays y salidas en un archivo local, sin recompilar. Esta primera etapa organiza las pestañas sin simular funciones que todavía no guardan datos." Foreground="#BBBBBB" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel></Grid>
        </TabItem>
    </TabControl>


</Window>