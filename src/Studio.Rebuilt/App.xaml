<Application x:Class="Studio.Rebuilt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="StudioBackground" Color="#10141B"/>
        <SolidColorBrush x:Key="StudioPanel" Color="#1A202B"/>
        <SolidColorBrush x:Key="StudioAccent" Color="#F04452"/>
        <SolidColorBrush x:Key="StudioText" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="StudioMuted" Color="#A8B0BE"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="Background" Value="#303948"/>
            <Setter Property="BorderBrush" Value="#465266"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#0C1016"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="BorderBrush" Value="#465266"/>
        </Style>
    </Application.Resources>
</Application>
