 <Window x:Class="Studio.Rebuilt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STUDIO V01 — Clean Rebuild" Height="900" Width="1500"
        MinHeight="760" MinWidth="1200" WindowStartupLocation="CenterScreen"
        Background="{StaticResource StudioBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="STUDIO V01" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="NÚCLEO NUEVO · PROGRAMA UNIFICADO" Foreground="{StaticResource StudioMuted}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#26303D" CornerRadius="5" Padding="12,7" VerticalAlignment="Center">
                <TextBlock x:Name="PipelineStatus" Text="NÚCLEO INICIALIZADO · ESPERANDO FUENTE" FontWeight="SemiBold" FontSize="11"/>
            </Border>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource StudioPanel}" CornerRadius="8" Padding="12">
                <TabControl Background="{StaticResource StudioPanel}" BorderThickness="0">
                    <TabItem Header="FUENTES">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,12">
                                <TextBlock Text="CONFIGURACIÓN JSON" FontWeight="Bold" Margin="3,6"/>
                                <Button Content="ABRIR CONFIG.JSON" Click="LoadConfig_Click"/>
                                <TextBlock x:Name="ConfigStatus" Text="Sin configuración cargada" TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="3,5"/>
                                <TextBlock Text="FUENTES DISPONIBLES" FontWeight="Bold" Margin="3,10,3,5"/>
                                <ListBox x:Name="SourcesList" MinHeight="150" MaxHeight="230" SelectionChanged="SourcesList_SelectionChanged" DisplayMemberPath="Name"/>
                                <Button Content="USAR FUENTE SELECCIONADA" Click="UseSelectedSource_Click"/>
                                <Separator Margin="4,12"/>
                                <TextBlock Text="RTSP / CÁMARA IP" FontWeight="Bold" Margin="3,6"/>
                                <TextBox x:Name="RtspAddress" Text="rtsp://" ToolTip="URL RTSP de la cámara"/>
                                <Button Content="CONFIGURAR RTSP MANUAL" Click="ConfigureRtsp_Click"/>
                                <Separator Margin="4,12"/>
                                <TextBlock Text="NDI" FontWeight="Bold" Margin="3,6"/>
                                <TextBlock Text="La detección y selección de fuentes NDI se conectarán al adaptador NDI." TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="3"/>
                                <Button Content="ACTUALIZAR FUENTES NDI" Click="RefreshNdi_Click"/>
                                <Separator Margin="4,12"/>
                                <TextBlock Text="GRILLA 2 × 2" FontWeight="Bold" Margin="3,6"/>
                                <TextBlock Text="Cuatro entradas configurables para componer una única salida." TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="3"/>
                                <Button Content="SELECCIONAR GRILLA" Click="SelectQuad_Click"/>
                                <Separator Margin="4,12"/>
                                <TextBlock Text="HTML / PROGRAMACIÓN" FontWeight="Bold" Margin="3,6"/>
                                <TextBox x:Name="HtmlAddress" Text="https://" ToolTip="URL de la página HTML"/>
                                <Button Content="CARGAR FUENTE HTML MANUAL" Click="ConfigureHtml_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="OVERLAYS">
                        <StackPanel Margin="8,14">
                            <TextBlock Text="CAPAS DE PROGRAMA" FontWeight="Bold" Margin="3,5,3,12"/>
                            <CheckBox x:Name="ClockToggle" Content="Reloj" Margin="4,7" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                            <CheckBox x:Name="LogoToggle" Content="Logo" Margin="4,7" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                            <CheckBox x:Name="WeatherToggle" Content="Clima" Margin="4,7" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                            <CheckBox x:Name="NewsToggle" Content="Noticias / zócalo" Margin="4,7" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                            <TextBlock Text="Los controles quedarán vinculados al compositor final; no habrá capas independientes en el preview." TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="3,18,3,3"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="SALIDAS">
                        <StackPanel Margin="8,14">
                            <TextBlock Text="DISTRIBUCIÓN DEL MISMO PROGRAMA" FontWeight="Bold" TextWrapping="Wrap" Margin="3,5,3,12"/>
                            <CheckBox x:Name="NdiOutputToggle" Content="NDI output" Margin="4,7" Checked="OutputChanged" Unchecked="OutputChanged"/>
                            <CheckBox x:Name="SrtOutputToggle" Content="SRT Caller" Margin="4,7" Checked="OutputChanged" Unchecked="OutputChanged"/>
                            <CheckBox x:Name="YouTubeOutputToggle" Content="YouTube RTMPS · H.264 / AAC" Margin="4,7" Checked="OutputChanged" Unchecked="OutputChanged"/>
                            <TextBlock Text="Los destinos de red y la captura de audio requieren configuración y pruebas en Windows antes de declararse operativos." TextWrapping="Wrap" Foreground="{StaticResource StudioMuted}" Margin="3,18,3,3"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Grid.Column="2" Background="#080B10" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="4,2,4,10">
                        <TextBlock Text="PREVIEW · PROGRAMA FINAL" FontSize="14" FontWeight="Bold"/>
                        <TextBlock DockPanel.Dock="Right" Text="1920 × 1080 · 29,97 fps objetivo" Foreground="{StaticResource StudioMuted}" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#111821" BorderBrush="#303948" BorderThickness="1">
                        <Grid>
                            <Image x:Name="ProgramPreview" Stretch="Fill" SnapsToDevicePixels="True"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                                <TextBlock Text="PROGRAMA EN ESPERA" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="La vista se alimentará del mismo ProgramFrame que consuman las salidas." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource StudioMuted}" Margin="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="2,10,2,0">
                        <TextBlock x:Name="FrameStatus" Text="Frame bus: sin fotogramas publicados" Foreground="{StaticResource StudioMuted}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="INVALIDAR FUENTE" Click="ResetProgram_Click"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#1A202B" CornerRadius="5" Padding="10,7" Margin="0,12,0,0">
            <TextBlock Text="BASE NUEVA EN DESARROLLO · La carga JSON configura las fuentes; la recepción y composición de video aún están pendientes." Foreground="{StaticResource StudioMuted}" FontSize="11"/>
        </Border>
    </Grid>
</Window>